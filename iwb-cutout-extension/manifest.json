{
  "manifest_version": 3,
  "name": "IWB 鲜艺抠图节点",
  "version": "2.6.0",
  "description": "在生图工作台画布中，为图片节点添加鲜艺AI抠图、白底大图、图层化图片编辑（图层、画笔、裁剪、标注）功能",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://iwb.maqiart.eu.org/*",
    "http://localhost:30092/*",
    "http://127.0.0.1:30092/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://iwb.maqiart.eu.org/*"],
      "js": ["editor.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "IWB 鲜艺抠图设置"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
